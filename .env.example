# Copy to .env (never commit .env). Fill values as you create resources.
# Keyless first: DefaultAzureCredential uses `az login`. Keys appear only where a day explicitly says so.

# Day 2 - Foundry project endpoint: https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT=gpt-5-mini
# Day 3 - embeddings deployment name (you choose it at deploy time)
AZURE_AI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Azure OpenAI-style endpoint of the same Foundry resource (used by azure-ai-evaluation on Day 5/11)
AZURE_OPENAI_ENDPOINT=

# Day 1 - local cost guard (tokens per day your scripts may spend)
DAILY_TOKEN_BUDGET=200000

# Day 5
CONTENT_SAFETY_ENDPOINT=

# Day 6
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=kd-chunks
# Only if Free-tier RBAC is not available (see Day 6). Leave empty otherwise.
AZURE_SEARCH_API_KEY=

# Day 11
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Day 13
DOC_INTELLIGENCE_ENDPOINT=
CONTENT_UNDERSTANDING_ENDPOINT=

# Day 14
VISION_ENDPOINT=

# Day 16
LANGUAGE_ENDPOINT=
TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
TRANSLATOR_REGION=
TRANSLATOR_KEY=

# Day 17 (Speech SDK lab uses a key; see the day for why)
SPEECH_KEY=
SPEECH_REGION=
